# Salin file ini menjadi `.env` lalu isi nilainya. File .env TIDAK BOLEH di-commit.

# Port server Express
PORT=3000

# Koneksi PostgreSQL
# Lokal : postgres://postgres:PASSWORD_ANDA@localhost:5432/photoquest
# Neon  : postgres://USER:PASS@HOST.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://postgres:PASSWORD_ANDA@localhost:5432/photoquest

# Rahasia penandatangan JWT. Isi string acak panjang, misalnya hasil:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti_dengan_string_acak_panjang
JWT_EXPIRES_IN=7d

# LLM (Plan AI & Assistant). Key hanya disimpan di backend, tidak di aplikasi Flutter.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Contoh: gemini-3.5-flash-lite. Cek model yang tersedia untuk key Anda dengan: npm run llm:check
GEMINI_MODEL=

# Timeout semua panggilan API eksternal (ms)
EXTERNAL_TIMEOUT_MS=8000

# true = endpoint /chain/tamper-demo dan /chain/repair-demo aktif (untuk presentasi)
DEMO_MODE=true
